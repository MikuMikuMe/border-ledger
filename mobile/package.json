{
  "name": "border-ledger-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android --appIdSuffix probe --main-activity com.lofuyu.borderledger.react.ReactNativeActivity",
    "typecheck": "tsc --noEmit",
    "test": "cd .. && node node_modules/vitest/vitest.mjs run tests/mobile- tests/thread-geometry.test.ts tests/canonical-thread-geometry.test.ts tests/web-thread-field.test.ts tests/native-parity-storage.test.ts",
    "codegen": "react-native codegen --platform android",
    "bundle:release": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output ../android/app/build/outputs/react-native/index.android.bundle --assets-dest ../android/app/build/outputs/react-native/assets"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@rn-primitives/slot": "1.5.2",
    "@shopify/react-native-skia": "2.14.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "3.7.0",
    "uniwind": "1.12.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.1.0",
    "babel-plugin-module-resolver": "5.0.3",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "codegenConfig": {
    "name": "BorderLedgerNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src/native/specs",
    "android": {
      "javaPackageName": "com.lofuyu.borderledger.react.codegen"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
