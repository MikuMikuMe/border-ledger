# Browser-visible public API origin only. Blank when Worker serves SPA and API together.
VITE_API_BASE_URL=

# SERVER ONLY: configure through Worker secrets/vars or ignored .dev.vars.
# These names are documentation, not a usable production configuration.
# ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# ACCESS_AUDIENCE=
# LEDGER_APP_ORIGIN=https://pf.lofuyu.com
# MOBILE_SESSION_ENCRYPTION_KEY=
# MOBILE_APPROVED_ACCESS_ISSUERS=
# MOBILE_APPROVED_ACCESS_AUDIENCES=
# MOBILE_ACCESS_AUTHORIZATION_URL=https://pf.lofuyu.com/mobile/authorize
# Identity enrollment is exact verified issuer+subject in D1 user_identities.
# No global ledger API key or subject allowlist grants data access.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENCRYPTION_KEY=
# PLAID_WEBHOOK_URL=https://pf.lofuyu.com/api/webhooks/plaid
# LUNCHFLOW_CLIENT_ID=
# LUNCHFLOW_CLIENT_SECRET=
# LUNCHFLOW_REDIRECT_URI=https://pf.lofuyu.com/api/lunchflow/oauth/callback
# LUNCHFLOW_TOKEN_ENCRYPTION_KEY=
# Optional legacy Personal feed; restricted to owner/personal only:
# LUNCHFLOW_API_KEY=
