# Browser-visible API origin. Leave blank when the Worker serves the SPA and API together.
VITE_API_BASE_URL=

# Cloudflare Access values are non-secret Worker variables used to validate the browser session.
# ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# ACCESS_AUDIENCE=
# LEDGER_APP_ORIGIN=https://pf.lofuyu.com
# PLAID_WEBHOOK_URL=https://pf.lofuyu.com/api/webhooks/plaid

# Server-only values belong in Cloudflare Worker secrets, never here.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENCRYPTION_KEY=
# LEDGER_API_KEY=
